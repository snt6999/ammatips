APP_NAME=Telugu Amma Tips API
# Generate a unique long random value before deploying.
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@teluguammatips.in
# Change this to a strong password before deploying.
ADMIN_PASSWORD=ChangeMe123!
CORS_ORIGINS=http://localhost:5173,https://your-site.netlify.app
# Supabase: paste the PostgreSQL connection string from Project Settings > Database.
# Prefer the Session pooler URL if your deployment environment has IPv4-only networking.
# Keep the full URL private. The app normalizes postgres:// and postgresql:// URLs automatically.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
